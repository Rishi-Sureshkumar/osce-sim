{
  "id": "exam-fcm1",
  "title": "Physical Examination (FCM-1 framework)",
  "kind": "exam",
  "sourceNote": "Items map to FCM-1 Physical Exam Framework numbers (fcmId). Labels are paraphrased; framework text not reproduced pending copyright clearance.",
  "items": [
    {
      "id": "fcm-01-hand-hygiene",
      "fcmId": 1,
      "section": "Clinical courtesy",
      "label": "Cleans hands before first touching the patient",
      "weight": 1,
      "scoring": "auto",
      "rule": {
        "hygieneBeforeTouch": true
      },
      "sourceText": ""
    },
    {
      "id": "fcm-02-notes",
      "fcmId": 2,
      "section": "Clinical courtesy",
      "label": "Note-taking does not interfere with rapport",
      "weight": 1,
      "scoring": "not_assessable",
      "notAssessableReason": "Note-taking behaviour and eye contact are not visible in this interface.",
      "sourceText": ""
    },
    {
      "id": "fcm-03-drape",
      "fcmId": 3,
      "section": "Clinical courtesy",
      "label": "Keeps the patient draped, covering areas again after examining them",
      "weight": 1,
      "scoring": "auto",
      "rule": {
        "any": [
          {
            "courtesy": "drape"
          },
          {
            "happened": "drape:cover"
          }
        ]
      },
      "sourceText": ""
    },
    {
      "id": "courtesy-introduce",
      "section": "Clinical courtesy",
      "label": "Introduces self by name and role",
      "weight": 1,
      "scoring": "auto",
      "rule": {
        "all": [
          {
            "said": "introduced_name"
          },
          {
            "said": "stated_role"
          }
        ]
      },
      "sourceText": ""
    },
    {
      "id": "courtesy-consent",
      "section": "Clinical courtesy",
      "label": "Asks permission before the first physical contact",
      "weight": 1,
      "scoring": "auto",
      "rule": {
        "before": [
          "tag:asked_consent_exam",
          "first:touch"
        ]
      },
      "sourceText": ""
    },
    {
      "id": "fcm-04-comfort",
      "fcmId": 4,
      "section": "Clinical courtesy",
      "label": "Verbally checks the patient's comfort during the exam",
      "weight": 1,
      "scoring": "ai",
      "guidance": "Credit if the student, during the physical exam, says something that shows attention to the patient's comfort or dignity: asks if they are comfortable, warns before touching/cold stethoscope, asks them to say if anything hurts, offers help repositioning.",
      "mockKeywords": [
        "comfortable",
        "let me know if",
        "hurt",
        "cold",
        "okay if i"
      ],
      "sourceText": ""
    },
    {
      "id": "courtesy-exit-hygiene",
      "section": "Clinical courtesy",
      "label": "Cleans hands again after the last contact, before leaving",
      "weight": 1,
      "scoring": "auto",
      "rule": {
        "all": [
          {
            "before": [
              "last:touch",
              "last:hand_hygiene"
            ]
          },
          {
            "happened": "room:exit"
          }
        ]
      },
      "sourceText": ""
    },
    {
      "id": "courtesy-closing",
      "section": "Clinical courtesy",
      "label": "Closes the encounter (thanks the patient / says goodbye)",
      "weight": 1,
      "scoring": "auto",
      "rule": {
        "said": "closing"
      },
      "sourceText": ""
    },
