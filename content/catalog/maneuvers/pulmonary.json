      "id": "vocal_resonance",
      "fcmId": 43,
      "label": "Vocal resonance / egophony",
      "system": "pulmonary",
      "technique": "auscultate",
      "allowedRegions": [
        "lung_post_ru",
        "lung_post_lu",
        "lung_post_rl",
        "lung_post_ll"
      ],
      "normalFinding": {
        "default": "Normal vocal resonance; spoken \"ee\" heard as \"ee\" (no egophony)."
      },
      "demo": {
        "steps": [
          "Place the diaphragm over the back of the chest.",
          "Ask the patient to say \"ee\" and listen for a change in the sound.",
          "Compare sides."
        ]
      },
      "penTerms": [
        "egophony",
        "vocal resonance",
        "whispered pectoriloquy"
      ]
    },
