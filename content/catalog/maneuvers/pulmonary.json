      "id": "chest_inspection",
      "fcmId": 41,
      "label": "Chest inspection & work of breathing",
      "system": "pulmonary",
      "technique": "inspect",
      "allowedRegions": [
        "lung_ant_ru",
        "lung_ant_lu",
        "lung_ant_rl",
        "lung_ant_ll",
        "lung_post_ru",
        "lung_post_lu",
        "lung_post_rl",
        "lung_post_ll",
        "lung_lat_r",
        "lung_lat_l"
      ],
      "normalFinding": {
        "default": "Symmetric chest shape and expansion; no accessory muscle use; no scars or lesions; breathing comfortably."
      },
      "demo": {
        "steps": [
          "With the patient seated, watch the whole chest rise and fall.",
          "Look at the neck muscles for extra effort with breathing.",
          "Check front, sides and back for scars, devices or skin changes."
        ]
      },
      "penTerms": [
        "accessory muscle",
        "accessory muscles",
        "work of breathing",
        "barrel chest"
      ]
    },
    {
      "requiresPositioning": [
        "seated",
        "seated_leaning_forward"
