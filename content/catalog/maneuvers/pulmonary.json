      "sourceText": "",
      "id": "auscultate_lungs",
      "fcmId": 42,
      "label": "Lung auscultation (breath sounds)",
      "system": "pulmonary",
      "technique": "auscultate",
      "allowedRegions": [
        "lung_ant_ru",
        "lung_ant_lu",
        "lung_ant_rl",
        "lung_ant_ll",
        "lung_lat_r",
        "lung_lat_l",
        "lung_post_ru",
        "lung_post_lu",
        "lung_post_rl",
        "lung_post_ll"
      ],
      "normalFinding": {
        "default": {
          "text": "Vesicular breath sounds; no crackles, wheezes or rubs.",
          "audio": {
            "generator": "breath",
            "params": {
              "type": "vesicular",
              "cracklesDensity": 0.5,
              "wheeze": false,
              "intensity": 0.7
            }
          }
        }
      },
      "demo": {
        "steps": [
          "Ask the patient to breathe deeply through the mouth.",
          "Press the diaphragm firmly and listen through a full breath at each spot.",
          "Compare side to side, working down the front, sides and back."
        ]
      },
      "interaction": "place",
      "tool": "stethoscope",
      "toolMode": "diaphragm",
      "penTerms": [
        "crackles",
        "rales",
        "wheeze",
        "wheezes",
        "wheezing",
        "breath sounds",
        "rhonchi",
        "air entry"
      ]
    },
