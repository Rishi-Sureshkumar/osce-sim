        "lung_post_lu",
        "lung_post_rl",
        "lung_post_ll"
      ],
      "normalFinding": {
        "default": "Resonant to percussion."
      },
      "demo": {
        "steps": [
          "Lay the middle finger of one hand flat on the chest between the ribs.",
