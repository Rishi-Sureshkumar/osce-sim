      "id": "tactile_fremitus",
      "fcmId": 44,
      "label": "Tactile fremitus",
      "system": "pulmonary",
      "technique": "palpate",
      "allowedRegions": [
        "lung_post_ru",
        "lung_post_lu",
        "lung_post_rl",
        "lung_post_ll"
      ],
      "normalFinding": {
        "default": "Tactile fremitus present and symmetric."
      },
      "demo": {
        "steps": [
          "Stand behind the patient and place the edge of your hand on the back.",
