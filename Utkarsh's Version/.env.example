# --- Access control (required in production) ---
# Code students type at /gate. Coaches type COACH_ACCESS_CODE instead (also grants student access).
ACCESS_CODE=change-me-student
COACH_ACCESS_CODE=change-me-coach
# Secret used to sign the access cookie. Use a long random string: `openssl rand -hex 32`
AUTH_SECRET=change-me-to-a-long-random-string

# --- Language layer ---
# No external model or API key: the patient, courtesy tags and grading are deterministic (src/lang).
# The sentence-embedding model is vendored into public/lang by `npm run lang:vendor` (runs on install).

# --- Database ---
# Postgres connection string (Neon / Vercel Postgres). If unset in local dev,
# a file-backed store at .data/store.json is used instead.
DATABASE_URL=

# --- Abuse limit (optional; default shown) ---
RATE_LIMIT_PER_MINUTE=60
# Test-only: shorten the exam-mode countdown (seconds). Leave unset in production.
# TIME_LIMIT_SECONDS_OVERRIDE=
